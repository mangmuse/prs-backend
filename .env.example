APP_NAME=PRS Backend
DEBUG=false
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:5173"]

# Database
# 로컬: postgresql+asyncpg://postgres:postgres@localhost:5432/prs
# Supabase (Transaction Pooler): postgresql+asyncpg://postgres.[ref]:[password]@aws-X-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prs

# LLM API Keys
OPENAI_API_KEY=your-key
GOOGLE_API_KEY=your-key
ANTHROPIC_API_KEY=your-key
