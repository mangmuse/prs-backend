{
  "family": "prs-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::271071983060:role/prs-ecs-execution-role",
  "containerDefinitions": [
    {
      "name": "prs-backend",
      "image": "271071983060.dkr.ecr.ap-northeast-2.amazonaws.com/prs-backend:v2",
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:271071983060:parameter/prs/DATABASE_URL"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:271071983060:parameter/prs/REDIS_URL"
        },
        {
          "name": "REDIS_TOKEN",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:271071983060:parameter/prs/REDIS_TOKEN"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:271071983060:parameter/prs/JWT_SECRET"
        }
      ],
      "environment": [
        {
          "name": "ENVIRONMENT",
          "value": "production"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/prs-backend",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "essential": true
    }
  ]
}
